# RapidGateway Configuration - SANDBOX MODE (Testing)
# Jab business verify hojayega aur Merchant ID milegi, tab ye values update karna

# RapidGateway API Credentials (Sandbox/Test Mode)
# Test credentials - sab merchants ke liye same hain sandbox ke liye
RAPIDGATEWAY_CLIENT_ID="client"
RAPIDGATEWAY_CLIENT_SECRET="secret"

# RapidGateway API Base URLs
RAPIDGATEWAY_API_URL="https://secure.rapid-gateway.com"
RAPIDGATEWAY_TOKEN_ENDPOINT="https://secure.rapid-gateway.com/oauth2/token"

# Environment Mode: "TEST" for sandbox, "LIVE" for production
RAPIDGATEWAY_ENVIRONMENT="TEST"

# Webhook Configuration
RAPIDGATEWAY_WEBHOOK_URL="http://localhost:3000/api/rapidgateway/webhook"

# Merchant Configuration (Sandbox ke liye "1" use karein - numeric ID required by API)
RAPIDGATEWAY_MERCHANT_ID="1"
RAPIDGATEWAY_MERCHANT_NAME="Wen Hair & Skin Secret"

# Webhook Signing Salt (for verifying webhook signatures)
RAPIDGATEWAY_SIGNING_SALT="26e3c87eca195c716a767c96688a7c201ede35a673fa41e711c15addb61fdcc8"

# Store Configuration
STORE_SUCCESS_URL="http://localhost:3000/order-success"
STORE_FAILURE_URL="http://localhost:3000/checkout?payment=failed"
STORE_CHECKOUT_URL="http://localhost:3000/checkout"

# Currency (Always PKR for Pakistan)
STORE_CURRENCY="PKR"

# Supabase Configuration (existing)
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_key"

# Clerk Configuration (existing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_key"
CLERK_SECRET_KEY="your_clerk_secret"
