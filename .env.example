# RapidGateway Configuration - SANDBOX MODE (Testing)
# Jab business verify hojayega aur Merchant ID milegi, tab ye values update karna

# RapidGateway API Credentials (Sandbox/Test Mode)
# Test credentials - sab merchants ke liye same hain sandbox ke liye
RAPIDGATEWAY_CLIENT_ID="client"
RAPIDGATEWAY_CLIENT_SECRET="secret"

# RapidGateway API Base URLs
# Sandbox testing ke liye TEST URL use hota hai
RAPIDGATEWAY_API_URL="https://secure.rapid-gateway.com"
RAPIDGATEWAY_TOKEN_ENDPOINT="https://secure.rapid-gateway.com/oauth2/token"
RAPIDGATEWAY_CHECKOUT_ENDPOINT="https://secure.rapid-gateway.com/v1/checkout-sessions"
RAPIDGATEWAY_PROCESS_TRANSACTION_ENDPOINT="https://secure.rapid-gateway.com/sandbox/process-transaction"

# Environment Mode: "TEST" for sandbox, "LIVE" for production
RAPIDGATEWAY_ENVIRONMENT="TEST"

# Webhook Configuration
# Ye URL webhook events receive karega (payment success/failure notifications)
RAPIDGATEWAY_WEBHOOK_URL="https://yourdomain.com/api/webhooks/rapidgateway"
RAPIDGATEWAY_WEBHOOK_SECRET=""  # Dashboard se milega jab account setup hoga

# Merchant Configuration (Abhi empty - baad mein fill karna)
# Jab business verify hoga, dashboard se ye values leni hongi
RAPIDGATEWAY_MERCHANT_ID=""  # Example: "384" ya "102" (numeric string)
RAPIDGATEWAY_MERCHANT_NAME="Wen Hair & Skin Secret"

# Store Configuration
STORE_SUCCESS_URL="https://yourdomain.com/order-success"
STORE_FAILURE_URL="https://yourdomain.com/checkout?payment=failed"
STORE_CHECKOUT_URL="https://yourdomain.com/checkout"

# Currency (Always PKR for Pakistan)
STORE_CURRENCY="PKR"
